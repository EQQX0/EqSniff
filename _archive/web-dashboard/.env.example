# Copy to .env.local and fill in. Never commit .env.local.

# Public site URL, no trailing slash (used for Stripe return URLs and auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Supabase: project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses row level security. Used by the Stripe webhook and cron routes.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe: use TEST mode keys until the deploy step
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs created in the Stripe dashboard
STRIPE_PRICE_BASE=
STRIPE_PRICE_TRAFFIC_CONTROL=

# Resend: transactional email sent by this app (payment failed notices)
RESEND_API_KEY=
EMAIL_FROM=

# Shared secret that scheduled jobs send as "Authorization: Bearer <value>"
CRON_SECRET=
