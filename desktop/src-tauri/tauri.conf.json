{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EqNetwork",
  "version": "0.3.0",
  "identifier": "app.networktoolkit.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "EqNetwork",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost https://bswzptrmeeobbnthjioz.supabase.co"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "resources": { "vendor/wintun/wintun.dll": "wintun.dll" }
  }
}
